# Copy to .env and replace the placeholder values before starting the stack.
POSTGRES_DB=taskstream_db
POSTGRES_USER=taskstream
POSTGRES_PASSWORD=change-me

CLIENT_DOMAIN=http://localhost:5173
SERVER_DOMAIN=http://localhost:8000

# Leave empty for the bundled Compose database. For RDS, set the full JDBC URL
# (for example: jdbc:postgresql://<endpoint>:5432/taskstream_db?sslmode=require)
# and set POSTGRES_USER / POSTGRES_PASSWORD to the RDS application credentials.
SPRING_DATASOURCE_URL=

# Required for password reset emails. Leave empty to start without email delivery.
SENDER_EMAIL=
SENDER_EMAIL_PASSWORD=

# AWS resource configuration. In ECS, prefer a task role over static access keys.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=taskstream-resources

# Generate a stable Base64 secret (for example: openssl rand -base64 32).
# Keep empty for local development; inject a stable value from Secrets Manager in ECS.
JWT_SECRET=

# Set true behind HTTPS in deployed environments.
OAUTH_SECURE_COOKIES=false
