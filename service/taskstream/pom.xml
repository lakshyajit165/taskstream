		<!--
			why is this "starter-validation" dependency required along with jakarta validation api?

			1️⃣ Jakarta Validation API (jakarta.validation:jakarta.validation-api)

			This only defines the interfaces and annotations for validation, e.g., @NotBlank, @Email, @Size.

			It does not provide any implementation of how the validation is actually performed.

			Think of it as a specification.

			If you include just the API, Spring Boot will compile fine, but at runtime nothing will validate, because there’s no engine to process the annotations.

			2️⃣ Hibernate Validator (or spring-boot-starter-validation)

			This is the implementation of the Jakarta Bean Validation API.

			It actually enforces the constraints on your fields (@NotBlank, @Email, etc.) at runtime.

			spring-boot-starter-validation includes Hibernate Validator and its dependencies automatically.

			✅ Why both are needed

			API = defines the annotations and interfaces.

			Implementation = enforces the rules at runtime.

			Without the implementation, @Valid has no effect — your validations will not trigger.

		-->
		<!-- https://mvnrepository.com/artifact/org.springframework.boot/spring-boot-starter-validation -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
			<version>3.5.5</version>
		</dependency>

		<!-- https://mvnrepository.com/artifact/jakarta.validation/jakarta.validation-api -->
		<dependency>
			<groupId>jakarta.validation</groupId>
			<artifactId>jakarta.validation-api</artifactId>
			<version>3.1.1</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!--

			A great comment explaining why this configuration is required in the maven-surefire-plugin would be:
			Summary of Purpose
			- This configuration is essential to guarantee that the isolated test environment is loaded when running tests via the command line (mvn test).
			- Plugin: The maven-surefire-plugin runs the tests.
			- argLine: Passes JVM arguments specifically to the process that runs your tests.
			- -Dspring.profiles.active=test: This JVM argument explicitly activates the test profile.
			Without this, the test runner might fail to load the application-test.yml overrides reliably,
			causing it to fall back to the default application.yml and attempt to connect to the external PostgreSQL database.

			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.2.5</version> <configuration>
				<argLine>
					-Dspring.profiles.active=test
				</argLine>
			</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-report-plugin</artifactId>
				<version>3.2.5</version>
			</plugin>
		</plugins>
	</build>
